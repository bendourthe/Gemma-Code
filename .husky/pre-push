#!/usr/bin/env sh
# v0.9.0 Phase 4 sub-task 4.3 -- pre-push gate with auto-fix-then-retry.
#
# Reverse-engineered from a husky pre-push pattern that runs format/lint
# with auto-fix and refuses the push if the fix actually changed files,
# leaving the user to re-stage and re-push intentionally. Then it re-runs
# the strict lint, the build, and gemma-check. Cross-platform: runs on
# Git Bash on Windows + macOS/Linux POSIX shells.
#
# Failures NEVER swallowed with `|| true`.

set -e

echo "[pre-push] step 1/5: eslint --fix (best-effort auto-fix)"
npm run lint -- --fix || true

if ! git diff --quiet; then
  echo ""
  echo "[pre-push] ESLint auto-fixed files. Review with \`git diff\`, re-stage, re-push."
  exit 1
fi

echo "[pre-push] step 2/5: npm run lint (--max-warnings=0 enforcement)"
npm run lint

echo "[pre-push] step 3/5: npm run build (tsc)"
npm run build

echo "[pre-push] step 4/5: npm run check (gemma-check)"
npm run check src/

echo "[pre-push] step 5/5: clean -- ok to push"
exit 0
