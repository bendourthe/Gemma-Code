#!/usr/bin/env sh
# v0.9.0 Phase 4 sub-task 4.3 -- pre-push gate with auto-fix-then-retry.
#
# Reverse-engineered from a husky pre-push pattern that runs format/lint
# with auto-fix and refuses the push if the fix actually changed files,
# leaving the user to re-stage and re-push intentionally. Then it re-runs
# the strict lint, the build, and gemma-check. Cross-platform: runs on
# Git Bash on Windows + macOS/Linux POSIX shells.
#
# Failures NEVER swallowed with `|| true`.

set -e

echo "[pre-push] step 1/6: eslint --fix (best-effort auto-fix)"
npm run lint -- --fix || true

if ! git diff --quiet; then
  echo ""
  echo "[pre-push] ESLint auto-fixed files. Review with \`git diff\`, re-stage, re-push."
  exit 1
fi

echo "[pre-push] step 2/6: npm run lint (--max-warnings=0 enforcement)"
npm run lint

echo "[pre-push] step 3/6: npm run build (tsc)"
npm run build

echo "[pre-push] step 4/6: npm run check (repository baseline)"
npm run check

# v1.4.0 Phase 3 (A2) -- test-tampering gate over tests/ and the CI workflows.
# Catches focused/.only tests, unjustified .skip, tautological assertions,
# commented-out assertions, and disabled CI checks. Error-severity rules
# (no-focused-tests, no-tautological-assertion) fail the push; the rest warn.
echo "[pre-push] step 5/6: npm run check:tampering (test-tampering rules)"
npm run check:tampering

echo "[pre-push] step 6/6: clean -- ok to push"
exit 0
