{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai/registry/manifest.schema.json",
  "title": "NexusModelManifest",
  "description": "v1.0.0 Phase 5.1 model manifest. References content-addressed blobs (blobs/sha256-<hex>) by SHA-256 + role. Stored at manifests/<family>/<name>/<tag>.json.",
  "type": "object",
  "required": ["schemaVersion", "id", "family", "name", "tag", "type", "blobs", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "tag": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["llm", "embed", "image", "video"] },
    "runtime": { "type": "string", "enum": ["ollama", "lmstudio", "diffusion", "video", "embed"] },
    "displayName": { "type": "string" },
    "license": { "type": "string" },
    "sizeBytes": { "type": "integer", "minimum": 0 },
    "vramGb": { "type": "number", "minimum": 0 },
    "blobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "sha256"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "enum": ["weights", "config", "tokenizer", "vae", "lora", "ipadapter", "controlnet", "data"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "filename": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "protocol": { "type": "string", "enum": ["ollama", "huggingface", "url"] },
        "url": { "type": "string" },
        "repo": { "type": "string" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string" }
  }
}
