coverage/
.nyc_output/
htmlcov/
TEST*.xml
*.lcov

# ==============================================================================
# Build Artifacts
# ==============================================================================
dist/
build/
out/
# PyQt installer packaging sources live under build/ — these are inputs to
# PyInstaller (scripts + .spec + hooks), not build outputs, so allow them.
# (v1.9.0: the two build dirs were unified into scripts/installer/build/.)
!scripts/installer/build/
!scripts/installer/build/**
# ...but the PyInstaller workpath + the mac/linux staging dir under build/
# ARE build outputs (re-excluded after the allow rules above).
scripts/installer/build/work/
# v1.11.0 P4: generated desktop-bundle staging (embedded into NexusSetup.exe)
scripts/installer/build/desktop-payload/
scripts/installer/build/stage/

# ==============================================================================
# Archives
# ==============================================================================
*.zip
*.tar.gz
*.rar

# ==============================================================================
# Large Media
# ==============================================================================
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.tiff

# ==============================================================================
# Claude Code Settings
# ==============================================================================
# Default-ignore everything under /.claude/ ...
/.claude/*
# ... then re-track the committed agent-agnostic subagent / slash-command
# artifacts (the markdown is reverse-engineered Gemma-Code-native and contains
# no Anthropic-specific bindings; per v0.9.0 Phase 3.2 / 3.3 / 3.5).
!/.claude/agents/
!/.claude/commands/
settings.local.json

