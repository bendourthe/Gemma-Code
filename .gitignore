*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==============================================================================
# Nexus / Gemma Code agent output and session sync
# ==============================================================================
# v1.0.0 Phase 2.2: storage root moved from .gemma-code/ -> .nexus/. The legacy
# .gemma-code/ pattern stays for one cycle so projects mid-migration do not
# accidentally commit the old workspace-local cache.
.gemma-code-output/
.nexus-output/
.gemma-code/
.nexus/

# ==============================================================================
# Go (CLI / Tooling)
# ==============================================================================
vendor/

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# ==============================================================================
# Installer Build Artifacts (Phase 7)
# ==============================================================================
scripts/installer/setup.exe
scripts/installer/backend-requirements.txt

# Generated by the audit-py CI job on each run; never committed.
scripts/installer/requirements-audit.txt

# ==============================================================================
# Python Coverage Data Files
# ==============================================================================
.coverage
coverage.xml

# ==============================================================================
# npm Auth Tokens
# ==============================================================================
.npmrc

# ==============================================================================
# Golden Task Suite (Phase 8)
# ==============================================================================
tests/golden/.worktrees/
tests/smoke/results/
tests/golden/snapshots/*/.git/
tests/golden/snapshots/*/node_modules/

# ==============================================================================
# Local build fixtures (v1.8.0 one-shot-installer Phase 1, T104)
# ==============================================================================
# Locally-built desktop bundles stashed as integration fixtures for the
# desktop provisioner tests (Phase 2, T204); machine-built binaries, never
# committed.
.local-fixtures/

# ==============================================================================
# Local A/B harness output (v1.6.0 openrouter-fusion Phase 4, OF010)
# ==============================================================================
# scripts/run-panel-ab.mjs writes per-run panel-vs-single comparison reports
# here when OLLAMA_URL is set; never committed (generated, machine-specific).
tests/benchmarks/results/

# ==============================================================================
# CI Workflow Outputs (v0.4.0 Phase 1: benchmark + golden-task gates)
# ==============================================================================
bench-results.json
bench-results.txt
golden-results-*.json
golden-report-*.md
golden-task-results.json
golden-task-report.md

# ==============================================================================
# Dependency-cruiser local graph output (v0.5.0 Phase 10)
# ==============================================================================
docs/archive/v0/v0.5/dep-graph.svg

# ==============================================================================
# Stryker mutation testing artifacts (v0.6.0 Phase 7.6)
# ==============================================================================
.stryker-tmp/
reports/stryker/

# ==============================================================================
# Debug runner logs (v0.9.0 Phase 4 sub-task 4.1)
# ==============================================================================
# scripts/debug/cli.mjs tees vitest output here; never committed.
out/debug-logs/

# ==============================================================================
# Deep-work git worktrees (v0.9.0 Phase 5 sub-task 5.1)
# ==============================================================================
# scripts/deep-work/start.mjs creates per-issue worktrees here; never committed.
worktrees/

# ==============================================================================
# HNSW vector index artifacts (v0.7.0 Phase 7)
# ==============================================================================
# Persisted under ~/.nexus/<workspace-id>/memory.hnsw (or the legacy
# ~/.gemma-code/<workspace-id>/memory.hnsw during the v1.0.0 compat window)
# at runtime; never committed. The pattern below catches any stray copies.
*.hnsw
memory.hnsw

# ==============================================================================
# Nexus desktop shell (v1.0.0 Phase 1)
# ==============================================================================
# Tauri + Vite build outputs, sidecar bundle, generated Tauri sources.
# Covered by `dist/` and `target/` above; the patterns below pin them
# explicitly so a future cleanup pass does not silently re-include them.
desktop/dist/
desktop/coverage/
desktop/sidecar/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/Cargo.lock
