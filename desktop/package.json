{
  "name": "@nexus/desktop",
  "private": true,
  "version": "1.1.0",
  "description": "Nexus desktop shell (Tauri 2.x + React 19 + Vite + Tailwind v4). Hosts the four pillars (Agentic AI Coding, Local Chatbot Explorer, Image Studio, Video Lab) and a Node sidecar process.",
  "type": "module",
  "scripts": {
    "dev:shell": "tauri dev",
    "build:shell": "tauri build",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:sidecar": "esbuild sidecar/src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=sidecar/dist/main.js",
    "preview": "vite preview --port 1421 --strictPort",
    "lint": "eslint src sidecar/src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
