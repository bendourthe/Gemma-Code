# Source and test files — not needed at runtime
src/**
tests/**
configs/**
scripts/**
docs/**
examples/**
lib/**
assets/**
!assets/icon.png
!assets/icon.svg
!assets/sidebar-icon.svg
!assets/vector.svg
!assets/specialists/**
coverage/**

# Build artifacts that are not extension output
out/test/**
out/**/*.map

# Tooling and CI configuration
.vscode/**
.vscode-test/**
.claude/**
.github/**
.gitignore
.gitattributes
.npmrc
.eslintignore
eslint.config.mjs
tsconfig.json
CHANGELOG.md
README.md
AGENTS.md

# Trim unnecessary files from bundled node_modules
# (vsce automatically excludes devDependencies when --no-dependencies is not used)
node_modules/**/*.md
node_modules/**/*.map
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/.npmignore
node_modules/**/.travis.yml
node_modules/**/CHANGELOG*
node_modules/**/LICENSE*
node_modules/**/HISTORY*
# better-sqlite3: exclude C++ source (only .node binary + JS lib needed)
node_modules/better-sqlite3/src/**
node_modules/better-sqlite3/deps/**
node_modules/better-sqlite3/binding.gyp
node_modules/better-sqlite3/build/Release/.forge-meta
# prebuild-install not needed at runtime
node_modules/prebuild-install/**
# v1.5.0 Phase 6 (T022.P3.A) -- Tree-sitter packaging. The codegraph scanner
# (core/codegraph/scanner/TreeSitterScanner.ts) parses 4 languages; ship only
# those 4 grammar .wasm and drop the other ~34 tree-sitter-wasms bundles to keep
# the VSIX small (the web-tree-sitter runtime tree-sitter.wasm is kept; it is not
# matched by any exclude). Guarantees the packaged extension uses the Tree-sitter
# parse path, not the regex fallback.
node_modules/tree-sitter-wasms/out/**
!node_modules/tree-sitter-wasms/out/tree-sitter-typescript.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-python.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-rust.wasm
!node_modules/tree-sitter-wasms/out/tree-sitter-go.wasm

# Python and Rust artifacts
**/__pycache__/**
**/*.pyc
**/*.pyo
# `target/**` only matches a top-level target dir; use `**/target/**` so nested
# Rust build trees (desktop/src-tauri/target/, and its node_modules symlink copy)
# are excluded too.
**/target/**

# v2.x -- the desktop Tauri app is a SEPARATE product, not part of the VS Code
# extension (no shipped extension code imports @nexus/desktop). It, and its
# npm-workspace symlink under node_modules/@nexus, were being packaged into the
# VSIX -- dragging in ~4.8 GB of Rust build artifacts (the target/ tree packaged
# twice: directly and via the symlink). Exclude both.
desktop/**
node_modules/@nexus/**

# Build outputs and local fixtures -- not extension runtime files.
dist/**
.local-fixtures/**

# TypeScript source maps and declaration files (already excluded via pattern below)
**/*.ts
!out/**/*.js
